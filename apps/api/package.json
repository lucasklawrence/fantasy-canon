{
  "name": "@fantasy-canon/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "node esbuild.mjs && tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -b && tsc -p src/client/tsconfig.json --noEmit",
    "build:client": "node esbuild.mjs",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.1.0",
    "@fantasy-canon/core": "workspace:*",
    "@fantasy-canon/db": "workspace:*",
    "@fantasy-canon/espn-client": "workspace:*",
    "@fantasy-canon/shared": "workspace:*",
    "dotenv": "^17.4.2",
    "matter-js": "^0.20.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/matter-js": "^0.20.2",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0"
  }
}
