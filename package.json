{
  "name": "fantasy-canon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "lint": "eslint \"{apps,packages,scripts}/**/*.{ts,tsx,js,jsx}\"",
    "format": "prettier --write \"{apps,packages,scripts,docs}/**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm -r run build",
    "dev": "pnpm -C apps/bot run dev",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "scripts/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "dotenv": "^16.4.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.4",
    "ts-node": "^10.9.2",
    "@types/node": "^20.11.5",
    "typescript": "^5.4.0",
    "vitest": "^1.3.1"
  }
}
