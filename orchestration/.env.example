# Copy to orchestration/.env and fill in. docker-compose.yaml reads these.
# Local dev only — never commit the real .env (it's gitignored).

# Public ESPN league to pull (defaults to the repo's example league).
ESPN_LEAGUE_ID=58246399
# Only needed for PRIVATE leagues (future, issue tracked separately). Leave blank for public.
ESPN_S2=
ESPN_SWID=

# Local Airflow admin login (used by airflow-init). admin/admin is fine locally.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# --- weekly_broadcast DAG (issue #51) ---
# Discord channel to post weekly cards to, and the bot token used to post.
BROADCAST_CHANNEL_ID=
DISCORD_TOKEN=
# Required by the bot's config loader (loadEnv) even though REST posting only uses the
# token. The application (client) id — same value the bot/deploy use.
DISCORD_APP_ID=
# Season to render; league defaults to ESPN_LEAGUE_ID above if BROADCAST_LEAGUE_ID is blank.
BROADCAST_SEASON=
BROADCAST_LEAGUE_ID=
# How the worker runs the bot's broadcast CLI. Leave blank — the custom Airflow image
# (orchestration/Dockerfile) bakes the repo at /opt/fantasy-canon, so the default
# `pnpm --dir /opt/fantasy-canon/apps/bot run broadcast --` works as-is. Override only
# if you run the CLI from a different path or via a separate bot container.
CANON_BROADCAST_CMD=

# --- espn_ingest DAG (issue #14) ---
# Season to ingest (required to run the DAG). Uses ESPN_LEAGUE_ID above.
INGEST_SEASON=
# Optional comma-separated view override (default: mTeam,mRoster,mScoreboard,mTransactions2,mSettings,mDraftDetail).
INGEST_VIEWS=
# Where snapshots are written (container path; mounted to ./data, gitignored).
SNAPSHOT_ROOT=/opt/airflow/data/snapshots
